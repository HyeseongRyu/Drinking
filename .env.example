# 사진 AI 분석에 필요한 Anthropic API 키.
# 절대 클라이언트(브라우저)에 노출하지 말 것 — 서버에서만 읽는다.
# 키 발급: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# 선택: 분석에 쓸 모델과 사고 강도(effort).
# 라벨 식별은 가벼운 작업이라 기본값은 low. 정확도가 아쉬우면 medium/high로 올린다.
# ANALYZE_MODEL=claude-opus-5
# ANALYZE_EFFORT=low

# 선택: 서버 포트와 DB 경로
# PORT=3001
# DB_PATH=./server/drinking.db
